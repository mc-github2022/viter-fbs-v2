RewriteEngine On
# use for authentication
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

Header set Access-Control-Allow-Origin *

RewriteRule ^upload-photo$ core/upload-photo.php [L]
RewriteRule ^upload-multiple-photo$ core/upload-multiple-photo.php [L]
RewriteRule ^upload-files$ core/upload-files.php [L]

# HOME - BANNER
RewriteRule ^banner$ controllers/developer/home/banner/banner.php [L]
RewriteRule ^banner/([0-9]+)$ controllers/developer/home/banner/banner.php?home_bannerid=$1 [L]

# HOME - TESTIMONIALS
RewriteRule ^testimonials$ controllers/developer/home/testimonials/testimonials.php [L]
RewriteRule ^testimonials/([0-9]+)$ controllers/developer/home/testimonials/testimonials.php?home_testimonialid=$1 [L]

# HOME - INSIGHT
RewriteRule ^insights$ controllers/developer/home/insights/insights.php [L]
RewriteRule ^insights/([0-9]+)$ controllers/developer/home/insights/insights.php?home_insightsid=$1 [L]

# SPECIAL OFFERS
RewriteRule ^specialOffers$ controllers/developer/special-offers/specialOffers.php [L]
RewriteRule ^specialOffers/([0-9]+)$ controllers/developer/special-offers/specialOffers.php?special_offersid=$1 [L]

# Why FBS - EVENTS AND ACTIVITIES
RewriteRule ^eventsAndAct$ controllers/developer/events-and-activities/eventsAndActivities.php [L]
RewriteRule ^eventsAndAct/([0-9]+)$ controllers/developer/events-and-activities/eventsAndActivities.php?events_activitiesid=$1 [L]
RewriteRule ^eventsAndAct/page/([0-9]+)$ controllers/developer/events-and-activities/page.php?start=$1 [L]
RewriteRule ^eventsAndAct/search$ controllers/developer/events-and-activities/search.php [L]

# Why FBS - CAREERS
RewriteRule ^careers$ controllers/developer/careers/careers.php [L]
RewriteRule ^careers/([0-9]+)$ controllers/developer/careers/careers.php?careersid=$1 [L]

# Why FBS - LCSS BATCHES
RewriteRule ^lcssBatches$ controllers/developer/lcss-batches/lcssBatches.php [L]
RewriteRule ^lcssBatches/([0-9]+)$ controllers/developer/lcss-batches/lcssBatches.php?lcss_batchid=$1 [L]
RewriteRule ^lcssBatches/page/([0-9]+)$ controllers/developer/lcss-batches/page.php?start=$1 [L]
RewriteRule ^lcssBatches/search$ controllers/developer/lcss-batches/search.php [L]

# INDUSTRY TESTIMONIAL
RewriteRule ^indTestimonial$ controllers/developer/industry-testimonial/industryTestimonial.php [L]
RewriteRule ^indTestimonial/([0-9]+)$ controllers/developer/industry-testimonial/industryTestimonial.php?industry_testimonialid=$1 [L]
RewriteRule ^indTestimonial/page/([0-9]+)$ controllers/developer/industry-testimonial/page.php?start=$1 [L]
RewriteRule ^indTestimonial/search$ controllers/developer/industry-testimonial/search.php [L]

# VIDEO TESTIMONIAL
RewriteRule ^vid-testimonial$ controllers/developer/vid-testimonial/vidTestimonial.php [L]
RewriteRule ^vid-testimonial/([0-9]+)$ controllers/developer/vid-testimonial/vidTestimonial.php?vid_testimonialid=$1 [L]
RewriteRule ^vid-testimonial/page/([0-9]+)$ controllers/developer/vid-testimonial/page.php?start=$1 [L]
RewriteRule ^vid-testimonial/search$ controllers/developer/vid-testimonial/search.php [L]

# SENDING EMAIL
RewriteRule ^sending-email$ controllers/developer/sending-email/sending-email.php [L]

# NOTIFICATIONS
RewriteRule ^notification-email$ controllers/developer/notification/notification.php [L]
RewriteRule ^notification-email/([0-9]+)$ controllers/developer/notification/notification.php?notificationId=$1 [L]
RewriteRule ^notification-email/active/([0-9]+)$ controllers/developer/notification/active.php?notificationId=$1 [L]
RewriteRule ^notification-email/page/([0-9]+)$ controllers/developer/notification/page.php?start=$1 [L]
RewriteRule ^notification-email/search$ controllers/developer/notification/search.php [L] 

# NOTIFICATION LOG
RewriteRule ^notificationlog$ controllers/developer/notification-log/notificationLog.php [L]
RewriteRule ^notificationlog/([0-9]+)$ controllers/developer/notification-log/notificationLog.php?notificationLogId=$1 [L]
RewriteRule ^notificationlog/page/([0-9]+)$ controllers/developer/notification-log/page.php?start=$1 [L]
RewriteRule ^notificationlog/search$ controllers/developer/notification-log/search.php [L] 

# USER - ROLE
RewriteRule ^role$ controllers/developer/user/role/role.php [L]
RewriteRule ^role/([0-9]+)$ controllers/developer/user/role/role.php?roleId=$1 [L]
RewriteRule ^role/active/([0-9]+)$ controllers/developer/user/role/active.php?roleId=$1 [L]
RewriteRule ^role/page/([0-9]+)$ controllers/developer/user/role/page.php?start=$1 [L]
RewriteRule ^role/search$ controllers/developer/user/role/search.php [L] 

### SETTINGS USERS OTHER ###
RewriteRule ^user-other$ controllers/developer/user/other-user/user-other.php [L]
RewriteRule ^user-other/([0-9]+)$ controllers/developer/user/other-user/user-other.php?userid=$1 [L]
RewriteRule ^user-other/page/([0-9]+)$ controllers/developer/user/other-user/page.php?start=$1 [L]
RewriteRule ^user-other/search$ controllers/developer/user/other-user/search.php [L]
RewriteRule ^user-other/active/([0-9]+)$ controllers/developer/user/other-user/active.php?userid=$1 [L]
RewriteRule ^user-other/verify-email/(.*)$ controllers/developer/user/other-user/update-email.php?userkey=$1 [L]
RewriteRule ^user-other/key/(.*)$ controllers/developer/user/other-user/key.php?userkey=$1 [L]
RewriteRule ^user-other/password$ controllers/developer/user/other-user/set-password.php [L]
RewriteRule ^user-other/login$ controllers/developer/user/other-user/login.php [L]
RewriteRule ^user-other/token$ controllers/developer/user/other-user/token.php [L]
RewriteRule ^user-other/reset$ controllers/developer/user/other-user/reset-password.php [L]
RewriteRule ^user-other/role$ controllers/developer/user/other-user/role.php [L] 

### SETTINGS USERS DEVELOPER ### 
RewriteRule ^user-developer$ controllers/developer/user/developer/developer.php [L]
RewriteRule ^user-developer/([0-9]+)$ controllers/developer/user/developer/developer.php?userdeveloperid=$1 [L]
RewriteRule ^user-developer/page/([0-9]+)$ controllers/developer/user/developer/page.php?start=$1 [L]
RewriteRule ^user-developer/search$ controllers/developer/user/developer/search.php [L]
RewriteRule ^user-developer/active/([0-9]+)$ controllers/developer/user/developer/active.php?userdeveloperid=$1 [L]
RewriteRule ^user-developer/verify-email/(.*)$ controllers/developer/user/developer/update-email.php?userdeveloperkey=$1 [L]
RewriteRule ^user-developer/key/(.*)$ controllers/developer/user/developer/key.php?userdeveloperkey=$1 [L]
RewriteRule ^user-developer/password$ controllers/developer/user/developer/set-password.php [L]
RewriteRule ^user-developer/login$ controllers/developer/user/developer/login.php [L]
RewriteRule ^user-developer/token$ controllers/developer/user/developer/token.php [L]
RewriteRule ^user-developer/reset$ controllers/developer/user/developer/reset-password.php [L]
RewriteRule ^user-developer/role$ controllers/developer/user/developer/role.php [L] 
 
# SUBSCRIBER
RewriteRule ^subscribe$ controllers/developer/subscribe/subscribe.php [L]
RewriteRule ^subscribe/([0-9]+)$ controllers/developer/subscribe/subscribe.php?subscribeid=$1 [L]
RewriteRule ^subscribe/page/([0-9]+)$ controllers/developer/subscribe/page.php?start=$1 [L]
RewriteRule ^subscribe/search$ controllers/developer/subscribe/search.php [L]
RewriteRule ^subscribe/active/([0-9]+)$ controllers/developer/subscribe/active.php?subscribeid=$1 [L]
RewriteRule ^subscribe/notif$ controllers/developer/subscribe/notification-subscriber.php [L]
RewriteRule ^subscribe/key/(.*)$ controllers/developer/subscribe/key.php?subscriberkey=$1 [L]
RewriteRule ^subscribe/unsubscribe/(.*)$ controllers/developer/subscribe/update-unsubscribe.php?subscriberkey=$1 [L]
RewriteRule ^subscribe/resend$ controllers/developer/subscribe/email-resend.php?subscriberkey=$1 [L]